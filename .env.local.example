# Supabase (required for smoke user seeding)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Corralio trusted server-only origin for password-recovery callbacks.
# Local: http://localhost:3002; production: https://corralio.com
CORRALIO_SITE_URL=http://localhost:3002
# Corralio Weekend Ready Web Push (server-only; public key is passed only to
# the authenticated opt-in component because the browser protocol requires it).
CORRALIO_VAPID_PUBLIC_KEY=
CORRALIO_VAPID_PRIVATE_KEY=
# Shared exact bearer secret for Corralio's isolated scheduled workers.
CRON_SECRET=

# Microsoft Clarity (analytics)
# Keep disabled in local/dev; set true in deployment envs that should load Clarity.
NEXT_PUBLIC_ANALYTICS_ENABLE_CLARITY=false
NEXT_PUBLIC_TI_CLARITY_PROJECT_ID=
NEXT_PUBLIC_RI_CLARITY_PROJECT_ID=

# Timezone lookup (Owl's Eye)
# Used to avoid Google Timezone API costs.
TIMEZONEDB_API_KEY=

# Email (shared)
# Reply-to used across TI + RI sends (unless overridden per-message).
EMAIL_REPLY_TO=hello@tournamentinsights.com
# Used to sign one-click unsubscribe links. Set the same value in TI + RI envs.
EMAIL_UNSUBSCRIBE_SECRET=
# Public TI URL used to generate unsubscribe links when sending from RI admin tools.
TI_PUBLIC_BASE_URL=https://www.tournamentinsights.com
# Default verified sender for TI outbound mail.
TI_OUTREACH_FROM=TournamentInsights <hello@mail.tournamentinsights.com>

# Playwright smoke targets
# TI app URL, e.g. http://127.0.0.1:3001
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3001
# RI app URL, e.g. http://127.0.0.1:3000
PLAYWRIGHT_RI_BASE_URL=http://127.0.0.1:3000

# TI explicit site origin for email redirects
NEXT_PUBLIC_TI_SITE_URL=https://www.tournamentinsights.com

# Cross-domain admin SSO (RI -> TI)
# Set the same value in both RI and TI environments.
TI_SSO_SECRET=
# Optional: increase if you keep RI admin open and click later (default 600s).
TI_SSO_TTL_SECONDS=600

# TI smoke join test code
TI_SMOKE_JOIN_CODE=VALID

# TI smoke users
TI_SMOKE_SEED_ALLOW=false
TI_SMOKE_EXPLORER_EMAIL=explorer_test@example.com
TI_SMOKE_EXPLORER_PASSWORD=
TI_SMOKE_INSIDER_EMAIL=insider_test@example.com
TI_SMOKE_INSIDER_PASSWORD=
TI_SMOKE_WEEKENDPRO_EMAIL=weekendpro_test@example.com
TI_SMOKE_WEEKENDPRO_PASSWORD=

# RI smoke credentials
# If RI uses a different Supabase auth project, set these explicitly.
# If RI shares auth with TI, you can leave blank to reuse TI insider credentials.
RI_SMOKE_EMAIL=
RI_SMOKE_PASSWORD=
# Perplexity (admin discovery); server-only.
PERPLEXITY_API_KEY=

# Stripe (TI)
# One-time $4.99 Founders Preview / Weekend Pass price id
STRIPE_WEEKEND_PASS_PRICE_ID=
# Corralio Slice 4.3 providers (server-only; configure only on Corralio).
GEOCODIO_API_KEY=
OPENROUTESERVICE_API_KEY=
# Corralio Slice 4.4C keyed anonymized evidence fingerprints (server-only, >=32 chars).
CORRALIO_EVIDENCE_FINGERPRINT_KEY=
